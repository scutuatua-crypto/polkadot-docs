name: Nathan Commit Gate

on:
  pull_request:
    types: [synchronize]

permissions:
  contents: read
  pull-requests: read
  actions: write

jobs:
  dispatch-nathan:
    if: false
    runs-on: ubuntu-latest
    steps:
      - name: Validate dispatcher permissions
        id: perm
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO: ${{ github.repository }}
          ACTOR: ${{ github.actor }}
        shell: bash
        run: |
          set -euo pipefail
          permission="$(gh api -H "Accept: application/vnd.github+json" "repos/${REPO}/collaborators/${ACTOR}/permission" --jq '.permission // ""' 2>/dev/null || true)"
          case "${permission}" in
            admin|maintain|write)
              echo "allowed=true" >> "$GITHUB_OUTPUT"
              ;;
            *)
              echo "allowed=false" >> "$GITHUB_OUTPUT"
              ;;
          esac

      - name: Check latest commit message (+Nathan)
        id: gate
        if: ${{ steps.perm.outputs.allowed == 'true' }}
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO: ${{ github.repository }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        shell: bash
        run: |
          set -euo pipefail
          commits_json="$(gh api --paginate "repos/${REPO}/pulls/${PR_NUMBER}/commits" | jq -s 'add')"
          msg="$(printf '%s' "$commits_json" | jq -r '.[-1].commit.message // ""')"
          if [[ "$msg" == *"+nathan"* ]]; then
            echo "triggered=true" >> "$GITHUB_OUTPUT"
          else
            echo "triggered=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Dispatch Nathan workflow
        if: ${{ steps.perm.outputs.allowed == 'true' && steps.gate.outputs.triggered == 'true' }}
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO: ${{ github.repository }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          gh api -X POST "repos/${REPO}/actions/workflows/trigger-n8n-workflow.yml/dispatches" \
            -f ref="main" \
            -f inputs[pr_number]="${PR_NUMBER}"
