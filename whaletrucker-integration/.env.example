# WhaleTrucker Polkadot Integration — Environment Variables
# Copy this file to .env and fill in the values before running any scripts.
#
# SECURITY: Never commit your actual .env file to version control.
#           The .env file is listed in .gitignore.

# ============================================================
# Network Selection
# ============================================================
# Set to "testnet" during development, "mainnet" for production.
NETWORK=testnet

# ============================================================
# RPC Endpoints — Polkadot Hub TestNet
# ============================================================
POLKADOT_TESTNET_RPC_URL=https://services.polkadothub-rpc.com/testnet/
POLKADOT_TESTNET_WSS_URL=wss://services.polkadothub-rpc.com/testnet/

# ============================================================
# RPC Endpoints — Polkadot Hub MainNet
# ============================================================
POLKADOT_MAINNET_RPC_URL=https://services.polkadothub-rpc.com/mainnet/
POLKADOT_MAINNET_WSS_URL=wss://services.polkadothub-rpc.com/mainnet/

# ============================================================
# RPC Endpoints — Kusama Hub (optional)
# ============================================================
POLKADOT_KUSAMA_RPC_URL=https://eth-rpc-kusama.polkadot.io/
POLKADOT_KUSAMA_WSS_URL=wss://eth-rpc-kusama.polkadot.io/

# ============================================================
# Wallet — use ONE of PRIVATE_KEY or MNEMONIC (not both)
# ============================================================
# Option A: raw private key (hex, no 0x prefix required by most tools)
PRIVATE_KEY=your_private_key_here

# Option B: BIP-39 mnemonic seed phrase (12 or 24 words)
# MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# ============================================================
# Gas Configuration
# ============================================================
# Override deployment gas limit (leave blank for automatic estimation +20%).
GAS_LIMIT=

# ============================================================
# Block Explorer API Keys (for contract verification)
# ============================================================
BLOCKSCOUT_TESTNET_API_KEY=your_testnet_blockscout_api_key_here
BLOCKSCOUT_MAINNET_API_KEY=your_mainnet_blockscout_api_key_here
